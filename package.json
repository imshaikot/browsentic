{
  "name": "browsentic",
  "version": "0.1.0",
  "description": "Browsentic — agentic browsing driven by the AI agent you already run",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.17.1",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "compile:mcp": "yarn --cwd mcp compile",
    "mcp:install": "yarn --cwd mcp install",
    "mcp:build": "yarn --cwd mcp build",
    "mcp:dev": "yarn --cwd mcp dev",
    "mcp:link": "cd mcp && npm link",
    "mcp:unlink": "npm rm -g @browsentic/mcp",
    "mcp:manifest": "yarn --cwd mcp build && node mcp/dist/cli.js tools",
    "intent:check": "node scripts/check-intent.mjs",
    "security:check": "node scripts/check-security.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@radix-ui/react-scroll-area": "^1.2.16",
    "@radix-ui/react-slot": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.26.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.2.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "wxt": "^0.20.27"
  }
}
