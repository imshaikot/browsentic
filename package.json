{
  "name": "browsentic",
  "version": "0.4.10",
  "description": "Browsentic — agentic browsing driven by the AI agent you already run",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.17.1",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "icons": "node scripts/generate-icons.mjs",
    "compile": "tsc --noEmit",
    "check": "yarn compile && yarn daemon:compile && yarn check:intent && yarn check:toolkit && yarn check:security",
    "check:intent": "node scripts/check-intent.mjs",
    "check:security": "node scripts/check-security.mjs",
    "check:toolkit": "node scripts/check-toolkit.mjs",
    "daemon:compile": "yarn --cwd src/daemon compile",
    "daemon:build": "yarn --cwd src/daemon build",
    "daemon:dev": "yarn --cwd src/daemon dev",
    "daemon:restart": "yarn daemon:build && node src/daemon/dist/cli.js restart",
    "daemon:manifest": "yarn daemon:build && node src/daemon/dist/cli.js tools",
    "daemon:link": "cd src/daemon && npm link",
    "daemon:unlink": "npm rm -g browsentic @browsentic/mcp"
  },
  "dependencies": {
    "@radix-ui/react-scroll-area": "^1.2.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.26.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.2.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "wxt": "^0.20.27"
  }
}
