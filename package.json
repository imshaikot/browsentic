{
  "name": "browsentic",
  "version": "0.7.6",
  "description": "Browsentic — agentic browsing driven by the AI agent you already run",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.17.1",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "lint:firefox": "web-ext lint --source-dir dist/firefox-mv2 --self-hosted",
    "sign:firefox": "web-ext sign --source-dir dist/firefox-mv2 --channel unlisted --artifacts-dir dist",
    "icons": "node scripts/generate-icons.mjs",
    "compile": "tsc --noEmit",
    "check": "yarn compile && yarn daemon:compile && yarn coverage",
    "check:intent": "node scripts/explain-intent.ts",
    "test": "vitest run",
    "test:integration": "vitest run --project integration",
    "coverage": "vitest run --coverage",
    "daemon:compile": "yarn --cwd src/daemon compile",
    "daemon:build": "yarn --cwd src/daemon build",
    "daemon:dev": "yarn --cwd src/daemon dev",
    "daemon:restart": "yarn daemon:build && node src/daemon/dist/cli.js restart",
    "daemon:manifest": "yarn daemon:build && node src/daemon/dist/cli.js tools",
    "daemon:link": "cd src/daemon && npm link",
    "daemon:unlink": "npm rm -g browsentic @browsentic/mcp",
    "mac:app": "yarn build && yarn daemon:build && src/mac/Scripts/build-app.sh",
    "mac:dmg": "yarn mac:app && src/mac/Scripts/make-dmg.sh"
  },
  "dependencies": {
    "@radix-ui/react-scroll-area": "^1.2.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.26.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^5.0.1",
    "@wxt-dev/module-react": "^1.2.2",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "web-ext": "^10.6.0",
    "wxt": "^0.20.27"
  }
}
