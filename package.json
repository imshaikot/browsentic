{
  "name": "browsentic-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Browsentic marketing site and documentation \u2014 static HTML, no client framework. Lives on the orphan `website` branch, never on `main`.",
  "scripts": {
    "sync:docs": "node scripts/sync-docs.mjs",
    "css": "tailwindcss -i src/css/main.css -o _site/assets/css/main.css",
    "css:watch": "tailwindcss -i src/css/main.css -o _site/assets/css/main.css --watch",
    "css:min": "tailwindcss -i src/css/main.css -o _site/assets/css/main.css --minify",
    "clean": "rm -rf _site .vercel/output",
    "build": "npm run clean && npm run sync:docs && npm run check:copy && eleventy && npm run css:min && node scripts/fingerprint.mjs && node scripts/verify.mjs",
    "dev": "npm run sync:docs && npm-run-all --parallel dev:*",
    "dev:11ty": "eleventy --serve --port 8080",
    "dev:css": "npm run css:watch",
    "verify": "node scripts/verify.mjs",
    "og": "node scripts/generate-og.mjs",
    "deploy": "./scripts/deploy.sh",
    "deploy:preview": "./scripts/deploy.sh --preview",
    "check:copy": "node scripts/check-copy.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "pack": "node scripts/vercel-output.mjs",
    "fingerprint": "node scripts/fingerprint.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.0",
    "@tailwindcss/cli": "^4.1.13",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-attrs": "^4.3.1",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4.1.13"
  }
}
