---
layout: layouts/page.njk
pageKey: orchestration
title: "Run several AI browser agents at once, in one browser"
seoTitle: "Agent orchestration: several tabs, several agents | Browsentic"
description: "A conversation belongs to the tab it started in. Eight sessions open, three running at once, each streaming back to the side panel from one local daemon."
keywords:
  - multiple AI agents one browser
  - concurrent browser automation
  - parallel agent sessions
  - multi-tab AI automation
  - background browser agent
  - agent session per tab
---
{% import "partials/macros.njk" as m with context %}

{% call m.pageHero(copy.SECTIONS.orchestrate.kicker, copy.SECTIONS.orchestrate.title, copy.SECTIONS.orchestrate.lede, "magenta") %}{% endcall %}

{% call m.section("board") %}
  {{ m.kicker("A board, mid-morning", "magenta") }}
  {{ m.heading("Four tabs, four conversations, one browser") }}
  {{ m.lede("Three sessions work at once by default, which is why the fourth is holding for a slot rather than crowding the browser.") }}

  <div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-4" data-reveal data-stagger>
    {%- for s in copy.ORCHESTRATION_SESSIONS %}
    <article class="card spotlight px-5 py-5">
      <div class="flex items-center justify-between gap-2">
        <span class="truncate font-mono text-[0.72rem] text-ink-faint">{{ s.host }}</span>
        <span class="shrink-0 rounded-full px-2 py-0.5 font-mono text-[0.65rem] {% if s.status == 'working' %}bg-lime/10 text-lime{% elif s.status == 'approval' %}bg-amber/10 text-amber{% else %}bg-surface text-ink-faint{% endif %}">{{ s.status }}</span>
      </div>
      <p class="mt-2 font-mono text-[0.7rem] text-ink-faint">{{ s.tab }}</p>
      <h3 class="mt-3 font-display text-[1rem] font-medium leading-snug text-ink">{{ s.title }}</h3>
      <ul class="mt-3.5 space-y-1.5">
        {%- for line in s.timeline %}
        <li class="flex gap-2 text-[0.82rem] leading-relaxed text-ink-faint"><span class="mt-1.5 size-1 shrink-0 rounded-full bg-ink-faint/60"></span>{{ line }}</li>
        {%- endfor %}
      </ul>
      <p class="mt-4 border-t border-line pt-3 font-mono text-[0.7rem] text-ink-faint">agent: {{ s.agent }}</p>
    </article>
    {%- endfor %}
  </div>
{% endcall %}

{% call m.section("chain", "bg-ground-2/30") %}
  {{ m.kicker("Underneath", "brand") }}
  {{ m.heading("One link out, one agent per session") }}

  <div class="mt-10 grid gap-4 md:grid-cols-2" data-reveal data-stagger>
    <article class="card spotlight px-6 py-6">
      <h3 class="font-display text-[1.05rem] font-semibold text-ink">{{ copy.ORCHESTRATION_CHAIN.daemon.title }}</h3>
      <p class="mt-1.5 font-mono text-[0.76rem] text-brand">{{ copy.ORCHESTRATION_CHAIN.daemon.sub }}</p>
      <p class="mt-3.5 text-[0.9rem] leading-relaxed text-ink-faint">{{ copy.ORCHESTRATION_CHAIN.daemon.body }}</p>
    </article>
    <article class="card spotlight px-6 py-6">
      <h3 class="font-display text-[1.05rem] font-semibold text-ink">{{ copy.ORCHESTRATION_CHAIN.agents.title }}</h3>
      <p class="mt-1.5 font-mono text-[0.76rem] text-brand">{{ copy.ORCHESTRATION_CHAIN.agents.sub }}</p>
      <p class="mt-3.5 text-[0.9rem] leading-relaxed text-ink-faint">{{ copy.ORCHESTRATION_CHAIN.agents.body }}</p>
    </article>
  </div>
{% endcall %}

{% call m.section("rules") %}
  {{ m.kicker("The rules that keep it sane", "lime") }}
  {{ m.heading("What a session can and cannot reach") }}

  <div class="mt-10 grid gap-4 md:grid-cols-2" data-reveal data-stagger>
    {%- for point in copy.ORCHESTRATION_POINTS %}
    <article class="card spotlight px-6 py-6">
      <h3 class="font-display text-[1.02rem] font-semibold leading-snug text-ink">{{ point[0] }}</h3>
      <p class="mt-2.5 text-[0.9rem] leading-relaxed text-ink-faint">{{ point[1] }}</p>
    </article>
    {%- endfor %}
  </div>

  <div class="card mt-4 border-brand/25 bg-brand/5 px-6 py-6">
    <span class="rounded-full bg-brand/10 px-2.5 py-1 font-mono text-[0.68rem] text-brand">{{ copy.ORCHESTRATION_SHARED.chip }}</span>
    <p class="mt-3.5 max-w-3xl text-[0.94rem] leading-relaxed text-ink-dim">{{ copy.ORCHESTRATION_SHARED.body }}</p>
  </div>
{% endcall %}

{{ m.nextUp([
  { href: "/docs/guide/features/conversations/", title: "Conversations", body: "Voice, text, one conversation per tab, and where history goes." },
  { href: "/docs/guide/configuration/", title: "maxConcurrentRuns", body: "Raise the three-at-once default as far as eight." },
  { href: "/mcp-server/", title: "Share it with other clients", body: "Claude Code, Cursor and Zed on the same browser at the same time." }
]) }}

{{ m.cta(copy) }}
