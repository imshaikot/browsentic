---
layout: layouts/page.njk
pageKey: skills
title: "Teach it your site: automatic site maps, recordings, instant commands"
seoTitle: "Skills: map any site, record and replay | Browsentic"
description: "Turn it loose on a web app and it maps itself, then hands you a skill to review before you arm it. Show it a job once and that becomes a skill of your own."
keywords:
  - record and replay browser automation
  - AI site mapping
  - browser macro recorder
  - teach AI agent a website
  - local intent classification
  - browser automation skills
  - agent skill files
---
{% import "partials/macros.njk" as m with context %}

{% call m.pageHero(copy.SECTIONS.teach.kicker, copy.SECTIONS.teach.title, copy.SECTIONS.teach.lede, "lime") %}{% endcall %}

{%- for mode in copy.MODES %}
{%- set accents = { "site-maps": "lime", recordings: "amber", instant: "brand" } %}
{%- set acc = m.ACCENT[accents[mode.id]] %}
<section id="{{ mode.id }}" class="border-b border-line {% if loop.index % 2 == 0 %}bg-ground-2/30{% endif %}">
  <div class="mx-auto max-w-7xl px-5 py-20 sm:px-8">
    <div class="grid gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:items-start">

      <div>
        {{ m.kicker(mode.kicker, accents[mode.id]) }}
        <h2 class="mt-3 max-w-2xl font-display text-[1.9rem] font-semibold leading-[1.16] text-ink sm:text-[2.2rem]">{{ mode.title }}</h2>
        <p class="mt-5 max-w-2xl text-[0.98rem] leading-relaxed text-ink-dim">{{ mode.body }}</p>

        <div class="mt-7">
          <p class="font-display text-[0.7rem] uppercase tracking-[0.1em] text-ink-faint">Invoke with</p>
          <code class="mt-2 inline-block rounded-lg border border-line bg-surface/40 px-3 py-2 font-mono text-[0.82rem] {{ acc.text }}">{{ mode.invocation }}</code>
        </div>

        <ul class="mt-8 space-y-4" data-reveal data-stagger>
          {%- for point in mode.points %}
          <li>
            <h3 class="font-display text-[0.98rem] font-medium text-ink">{{ point[0] }}</h3>
            <p class="mt-1 text-[0.88rem] leading-relaxed text-ink-faint">{{ point[1] }}</p>
          </li>
          {%- endfor %}
        </ul>
      </div>

      <div class="card overflow-hidden">
        <div class="border-b border-line px-4 py-2.5">
          <span class="font-mono text-[0.7rem] uppercase tracking-wider text-ink-faint">{{ mode.tab }}</span>
        </div>
        <ul class="divide-y divide-line font-mono text-[0.78rem]">
          {%- for row in mode.tree %}
          <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 px-4 py-2.5">
            <span class="{{ acc.text }}">{{ row[0] }}</span>
            {%- if row[1] %}<span class="text-ink-faint">{{ row[1] }}</span>{% endif %}
          </li>
          {%- endfor %}
        </ul>
      </div>

    </div>
  </div>
</section>
{%- endfor %}

{% call m.section("safety") %}
  {{ m.kicker("Before any of it runs", "ember") }}
  {{ m.heading("A skill is inert until you read it and arm it") }}
  {{ m.lede("A map in flight is written to a staging directory the skill loader cannot read. An unreviewed map is not merely unused. It is never opened.") }}

  <div class="mt-10 grid gap-4 lg:grid-cols-3" data-reveal data-stagger>
    <article class="card spotlight px-6 py-6">
      <h3 class="font-display text-[1.02rem] font-semibold text-ink">You read the exact markdown</h3>
      <p class="mt-3 text-[0.9rem] leading-relaxed text-ink-faint">The panel shows it as plain text, never rendered, alongside the domain it will match. Activate arms it, Discard deletes it.</p>
    </article>
    <article class="card spotlight px-6 py-6">
      <h3 class="font-display text-[1.02rem] font-semibold text-ink">Locked to one host</h3>
      <p class="mt-3 text-[0.9rem] leading-relaxed text-ink-faint">A mapping run is read-only: it cannot click, fill or submit, cannot leave the site, and stays pinned to the tab it started in.</p>
    </article>
    <article class="card spotlight px-6 py-6">
      <h3 class="font-display text-[1.02rem] font-semibold text-ink">Ceilings you can narrow, never widen</h3>
      <p class="mt-3 text-[0.9rem] leading-relaxed text-ink-faint">15 pages, 10 screenshots and 10 minutes by default. 40, 24 and 30 minutes are hard limits the daemon enforces.</p>
    </article>
  </div>
{% endcall %}

{{ m.nextUp([
  { href: "/docs/guide/features/site-maps/", title: "Site maps", body: "Teaching it a site once, and what lands on disk when it does." },
  { href: "/docs/guide/features/recordings/", title: "Recordings", body: "Showing it a task once and repeating it later, placeholders and all." },
  { href: "/docs/guide/features/instant-commands/", title: "Instant commands", body: "The things that run in milliseconds without ever reaching an agent." }
]) }}

{{ m.cta(copy) }}
