---
layout: layouts/page.njk
pageKey: automations
title: "What to automate: job applications, cancellations, renewals"
seoTitle: "Browser automations: the jobs people actually hand over | Browsentic"
description: "Automate a job application, negotiate a renewal, cancel what you stopped using, or redo Friday's report. Anything that commits stops and asks you first."
keywords:
  - automate job applications
  - cancel subscription automatically
  - automate support chat
  - browser workflow automation
  - automate repetitive web forms
  - AI fill web forms
  - automate expense report
---
{% import "partials/macros.njk" as m with context %}

{% call m.pageHero(copy.SECTIONS.automations.kicker, copy.SECTIONS.automations.title, copy.SECTIONS.automations.lede, "amber") %}{% endcall %}

<!-- Worked example -->
{% call m.section("worked-example") %}
  <div class="grid gap-12 lg:grid-cols-[1fr_1fr] lg:items-start">
    <div>
      {{ m.kicker(copy.AUTOMATION_FEATURED.kicker, "amber") }}
      {{ m.heading(copy.AUTOMATION_FEATURED.title) }}
      <p class="mt-5 max-w-2xl text-[1rem] leading-relaxed text-ink-dim">{{ copy.AUTOMATION_FEATURED.body }}</p>

      <div class="mt-8 flex flex-wrap gap-2">
        {%- for gate in copy.AUTOMATION_FEATURED.gates %}
        <span class="rounded-lg border border-amber/30 bg-amber/5 px-3 py-1.5 font-mono text-[0.73rem] text-amber">{{ gate }}</span>
        {%- endfor %}
      </div>
    </div>

    <div class="card overflow-hidden">
      <div class="flex items-center gap-2 border-b border-line px-4 py-3">
        <span class="size-2.5 rounded-full bg-ember/70"></span>
        <span class="size-2.5 rounded-full bg-amber/60"></span>
        <span class="size-2.5 rounded-full bg-lime/50"></span>
        <span class="ml-2 font-mono text-[0.72rem] text-ink-faint">jobs.acme.com</span>
      </div>
      <ol class="space-y-3.5 px-5 py-5">
        {%- for step in copy.AUTOMATION_FEATURED.steps %}
        <li class="flex items-start gap-3">
          <span class="mt-1.5 size-1.5 shrink-0 rounded-full {% if step.gate %}bg-amber{% else %}bg-brand/60{% endif %}"></span>
          <div class="min-w-0">
            <code class="font-mono text-[0.8rem] {% if step.gate %}text-amber{% else %}text-ink-dim{% endif %}">{{ step.tool }}</code>
            <p class="mt-0.5 text-[0.82rem] leading-relaxed text-ink-faint">{{ step.note }}</p>
            {%- if step.gate %}<p class="mt-1 text-[0.75rem] text-amber">asks you first</p>{% endif %}
          </div>
        </li>
        {%- endfor %}
        <li class="border-t border-line pt-3.5 text-[0.84rem] text-lime">✓ {{ copy.AUTOMATION_FEATURED.result }}</li>
      </ol>
    </div>
  </div>
{% endcall %}

<!-- The rest -->
{% call m.section("jobs", "bg-ground-2/30") %}
  {{ m.kicker("Six more", "ember") }}
  {{ m.heading("Ordinary work, on sites you are already signed in to") }}
  {{ m.lede("Each one names the tools it reaches for, and the moment it stops and hands the decision back to you.") }}

  <div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-3" data-reveal data-stagger>
    {%- for a in copy.AUTOMATIONS %}
    {%- set ac = m.ACCENT[a.accent] %}
    <article id="{{ a.id }}" class="card flex flex-col px-6 py-6">
      <span class="block size-2 rounded-full {{ ac.dot }}"></span>
      <h3 class="mt-3.5 font-display text-[1.05rem] font-semibold leading-snug text-ink">{{ a.title }}</h3>
      <p class="mt-3 flex-1 text-[0.88rem] leading-relaxed text-ink-faint">{{ a.body }}</p>

      <div class="mt-5 flex flex-wrap gap-1.5">
        {%- for tool in a.tools %}{{ m.toolChip(tool) }}{% endfor %}
      </div>
      <p class="mt-4 border-t border-line pt-3.5 text-[0.8rem] {{ ac.text }}">{{ a.gate }}</p>
    </article>
    {%- endfor %}
  </div>
{% endcall %}

<!-- Where it stops -->
{% call m.section("gates") %}
  {{ m.kicker("The gate", "amber") }}
  {{ m.heading("Anything that reaches someone other than you pauses first") }}
  {{ m.lede("Approval prompts appear in the side panel with the action named. Form submission is gated by default, because it is the one effect that leaves your machine and lands on somebody else's desk.") }}

  <div class="mt-10 grid gap-4 lg:grid-cols-3" data-reveal data-stagger>
    <article class="card spotlight px-6 py-6">
      <h3 class="font-display text-[1.02rem] font-semibold text-ink">Gated out of the box</h3>
      <p class="mt-3 text-[0.9rem] leading-relaxed text-ink-faint">Form submission and file upload. Both reach an outside party, so both name themselves and wait.</p>
    </article>
    <article class="card spotlight px-6 py-6">
      <h3 class="font-display text-[1.02rem] font-semibold text-ink">Gate anything else you like</h3>
      <p class="mt-3 text-[0.9rem] leading-relaxed text-ink-faint">Name a tool in <code class="font-mono text-[0.8rem] text-amber">requireApproval</code> and it asks every time, which is useful for the last click of a cancellation.</p>
    </article>
    <article class="card spotlight px-6 py-6">
      <h3 class="font-display text-[1.02rem] font-semibold text-ink">Grant it per host</h3>
      <p class="mt-3 text-[0.9rem] leading-relaxed text-ink-faint">Approve once with <em class="text-ink-dim">Always on this host</em> when you are working a long list and every row asks the same question.</p>
    </article>
  </div>

  <div class="mt-8">{{ m.button("/docs/guide/approvals/", "Approvals and guardrails", "ghost") }}</div>
{% endcall %}

{{ m.nextUp([
  { href: "/skills/", title: "Show it once, repeat it later", body: "Recordings turn a job you did by hand into a skill of your own." },
  { href: "/docs/guide/approvals/", title: "Tune the gate", body: "What asks before it acts, what is refused outright, and how to change either." },
  { href: "/docs/guide/limits/", title: "Where it does not fit", body: "The honest boundaries. Read this before relying on it for anything." }
]) }}

{{ m.cta(copy) }}
