---
layout: layouts/page.njk
pageKey: privacy
title: "Privacy: what Browsentic collects, and what it does not"
seoTitle: "Privacy | Browsentic"
description: "The extension sends us nothing: no account, no telemetry, no server. This website uses Google Analytics, and you can block it. Here is the whole of it."
keywords:
  - browsentic privacy
  - browser automation privacy
  - local AI agent privacy
  - browser extension data collection
  - no telemetry browser agent
---
{% import "partials/macros.njk" as m with context %}

{% call m.pageHero("Privacy", "What we collect, and what we do not", copy.PRIVACY.lede, "lime") %}
<p class="mt-6 font-mono text-[0.78rem] text-ink-faint">Last updated {{ copy.PRIVACY.updated }}</p>
{% endcall %}

{% call m.section("short") %}
  {{ m.kicker("The short version", "lime") }}
  {{ m.heading("Before the detail") }}

  <div class="mt-10 grid gap-4 lg:grid-cols-3" data-reveal data-stagger>
    {%- for item in copy.PRIVACY.summary %}
    {%- set a = m.ACCENT[item.accent] %}
    <article class="card spotlight px-6 py-6">
      <span class="block size-2 rounded-full {{ a.dot }}"></span>
      <h2 class="mt-3.5 font-display text-[1.05rem] font-semibold leading-snug text-ink">{{ item.title }}</h2>
      <p class="mt-3 text-[0.9rem] leading-relaxed text-ink-faint">{{ item.body }}</p>
    </article>
    {%- endfor %}
  </div>
{% endcall %}

{% call m.section("website", "bg-ground-2/30") %}
  {{ m.kicker("This website", "amber") }}
  {{ m.heading("Who sees anything when you read this page") }}
  {{ m.lede(copy.PRIVACY.site.lede) }}

  <div class="mt-10 grid gap-4 lg:grid-cols-3" data-reveal data-stagger>
    {%- for row in copy.PRIVACY.site.rows %}
    <article class="card spotlight px-6 py-6">
      <h3 class="font-display text-[1.02rem] font-semibold text-ink">{{ row.what }}</h3>
      <p class="mt-1.5 font-mono text-[0.75rem] text-amber">{{ row.who }}</p>
      <p class="mt-3 text-[0.9rem] leading-relaxed text-ink-faint">{{ row.body }}</p>
    </article>
    {%- endfor %}
  </div>

  <p class="mt-6 max-w-2xl text-[0.9rem] leading-relaxed text-ink-faint" data-reveal>The analytics tag is the one thing on this site we would rather not need. It is there so we can tell which pages people actually read, and it is the first thing to go if a cookieless alternative covers it.</p>
{% endcall %}

{% call m.section("product") %}
  {{ m.kicker("The product", "brand") }}
  {{ m.heading("What the extension writes, and where it stays") }}
  {{ m.lede(copy.PRIVACY.product.lede) }}

  <div class="mt-10 grid gap-4 lg:grid-cols-3" data-reveal data-stagger>
    {%- for row in copy.PRIVACY.product.stays %}
    <article class="card spotlight px-5 py-5">
      <code class="font-mono text-[0.85rem] text-brand">{{ row[0] }}</code>
      <p class="mt-3 text-[0.88rem] leading-relaxed text-ink-faint">{{ row[1] }}</p>
    </article>
    {%- endfor %}
  </div>
{% endcall %}

{% call m.section("leaves", "bg-ground-2/30") %}
  {{ m.kicker("Stated plainly", "ember") }}
  {{ m.heading(copy.PRIVACY.product.leavesTitle) }}

  <div class="mt-10 grid gap-4 lg:grid-cols-3" data-reveal data-stagger>
    {%- for item in copy.PRIVACY.product.leaves %}
    <article class="card border-amber/25 bg-amber/5 px-6 py-6">
      <h3 class="font-display text-[1.02rem] font-semibold leading-snug text-amber">{{ item.title }}</h3>
      <p class="mt-3 text-[0.9rem] leading-relaxed text-ink-dim">{{ item.body }}</p>
    </article>
    {%- endfor %}
  </div>
{% endcall %}

{% call m.section("choices") %}
  {{ m.kicker("Your choices", "brand-deep") }}
  {{ m.heading("What you can do about any of it") }}

  <div class="mt-10 grid gap-4 lg:grid-cols-3" data-reveal data-stagger>
    {%- for item in copy.PRIVACY.choices %}
    <article class="card spotlight px-6 py-6">
      <h3 class="font-display text-[1.02rem] font-semibold text-ink">{{ item.title }}</h3>
      <p class="mt-3 text-[0.9rem] leading-relaxed text-ink-faint">{{ item.body }}</p>
    </article>
    {%- endfor %}
  </div>

  <div class="mt-8 flex flex-wrap gap-3">
    {{ m.button(site.repo + "/issues", "Ask a question", "ghost", true) }}
    {{ m.button(site.repo + "/security/advisories/new", "Report something privately", "ghost", true) }}
  </div>

  <p class="mt-8 max-w-2xl text-[0.88rem] leading-relaxed text-ink-faint" data-reveal>If this page changes, the date at the top changes with it, and the diff is in the repository like everything else.</p>
{% endcall %}

{{ m.nextUp([
  { href: "/security/", title: "The security model", body: "Two transport gates, sealed credentials, and where it stops short." },
  { href: "/docs/internals/state/", title: "Every file it writes", body: "What lands under your home directory, and why each piece is there." },
  { href: "/how-it-works/", title: "How it works", body: "Four hops, every one of them on your own machine." }
]) }}

{{ m.cta(copy) }}
