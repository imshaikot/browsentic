---
layout: layouts/page.njk
pageKey: home
title: "Browsentic: AI browser automation in the browser you already use"
seoTitle: "Browsentic: the AI browser extension for your logged-in browser"
description: "A browser extension that hands any tab to the AI agent you already run. 41 page tools in the logged-in session you already use. No API key, no headless browser."
socialTitle: "Browsentic: every tab, its own AI agent"
socialDescription: "Hand any tab to Claude Code, Codex or Antigravity. 41 page tools, three tabs automated at once, record and replay, site maps. Local only, no API key."
keywords:
  - AI browser automation
  - browser AI agent
  - browser extension AI
  - AI browser extension for Chrome
  - automate logged-in browser
  - record and replay browser
  - agentic browsing
  - browser automation without API key
showFaq: true
---
{% import "partials/macros.njk" as m with context %}

<!-- Hero -->
<section class="relative overflow-hidden border-b border-line">
  <div class="dot-grid mask-radial pointer-events-none absolute inset-0"></div>
  <div class="pointer-events-none absolute -top-48 left-1/2 size-[46rem] -translate-x-1/2 rounded-full bg-brand/10 blur-[140px] animate-drift"></div>

  <div class="relative mx-auto max-w-7xl px-5 pb-20 pt-24 sm:px-8 sm:pt-32">
    <div class="grid items-center gap-14 lg:grid-cols-[0.88fr_1.12fr]">
      <div>
        <p class="inline-flex max-w-xl rounded-full border border-line bg-surface/40 px-3.5 py-1.5 text-[0.78rem] leading-snug text-ink-dim" data-enter style="--enter-delay: 0ms">{{ copy.HERO.badge }}</p>

        <h1 class="mt-6 font-display text-[2.85rem] font-semibold leading-[1.03] tracking-[-0.03em] text-ink sm:text-[4rem]" data-enter style="--enter-delay: 70ms">
          {{ copy.HERO.title.lead }}<br>{{ copy.HERO.title.tail }}<span class="text-gradient">{{ copy.HERO.title.accent }}</span>
        </h1>

        <p class="mt-7 max-w-xl text-[1.08rem] leading-relaxed text-ink-dim" data-enter style="--enter-delay: 140ms">{{ copy.HERO.lede }}</p>

        <div class="mt-9 flex flex-wrap items-center gap-3" data-enter style="--enter-delay: 210ms">
          {{ m.button("/install/", "Install the extension") }}
          {{ m.button("/how-it-works/", "See how it works", "ghost") }}
        </div>
        <p class="mt-3 text-[0.82rem] text-ink-faint" data-enter style="--enter-delay: 250ms">Chrome and Chromium &middot; {{ copy.HERO.voice }}</p>
      </div>

      <div data-enter style="--enter-delay: 300ms">
        {% include "partials/hero-demo.njk" %}
      </div>
    </div>

    <!-- Not two equal doors: the extension is the product, MCP is the optional path. -->
    <div class="mt-16 grid gap-4 md:grid-cols-[1.2fr_0.8fr]" data-reveal data-stagger>
      {%- for path in copy.HERO_PATHS %}
      {%- set a = m.ACCENT[path.accent] %}
      <article class="card spotlight flex flex-col px-6 py-6">
        <div class="flex items-center gap-2.5">
          <span class="size-2 rounded-full {{ a.dot }}"></span>
          <p class="font-display text-[0.7rem] uppercase tracking-[0.11em] {{ a.text }}">{{ path.kicker }}</p>
        </div>
        <h2 class="mt-3 font-display text-[1.25rem] font-semibold text-ink">{{ path.title }}</h2>
        <p class="mt-2.5 flex-1 text-[0.9rem] leading-relaxed text-ink-faint">{{ path.body }}</p>
        {%- if path.command %}
        <div class="mt-5">{{ m.command(path.command) }}</div>
        {%- endif %}
        <div class="mt-5">{{ m.button(path.cta.href, path.cta.label, "ghost") }}</div>
      </article>
      {%- endfor %}
    </div>
  </div>
</section>

<!-- Stats -->
<section class="border-b border-line bg-ground-2/30">
  <div class="mx-auto grid max-w-7xl grid-cols-2 gap-px px-5 sm:px-8 lg:grid-cols-4" data-reveal data-stagger>
    {%- for stat in copy.STATS %}
    <div class="px-2 py-10 sm:px-6">
      <p class="font-display text-[2.4rem] font-semibold leading-none text-ink"><span data-count="{{ stat.value }}">{{ stat.value }}</span>{{ stat.suffix }}</p>
      <p class="mt-2 text-[0.92rem] font-medium text-ink-dim">{{ stat.label }}</p>
      <p class="mt-1 text-[0.8rem] text-ink-faint">{{ stat.note }}</p>
    </div>
    {%- endfor %}
  </div>
</section>

<!-- How it works -->
{% call m.section("how") %}
  {{ m.kicker(copy.SECTIONS.how.kicker) }}
  {{ m.heading(copy.SECTIONS.how.title) }}
  {{ m.lede(copy.SECTIONS.how.lede) }}

  <ol class="mt-12 grid gap-4 lg:grid-cols-4" data-reveal data-stagger>
    {%- for node in copy.PIPELINE %}
    <li class="card spotlight relative px-5 py-6">
      {%- if not loop.last %}
      <span class="rail pointer-events-none absolute left-full top-1/2 z-10 hidden h-4 w-4 -translate-y-1/2 lg:block" style="--rail-delay: {{ loop.index0 * 0.7 }}s" aria-hidden="true"></span>
      {%- endif %}
      <span class="font-mono text-[0.7rem] text-ink-faint">0{{ loop.index }}</span>
      <h3 class="mt-2.5 font-display text-[1.12rem] font-semibold text-ink">{{ node.title }}</h3>
      <p class="mt-1 text-[0.8rem] font-medium text-brand">{{ node.sub }}</p>
      <p class="mt-3 text-[0.88rem] leading-relaxed text-ink-faint">{{ node.body }}</p>
    </li>
    {%- endfor %}
  </ol>

  <div class="mt-8">{{ m.button("/how-it-works/", "Read the architecture", "ghost") }}</div>
{% endcall %}

<!-- Capabilities -->
{% call m.section("capabilities") %}
  {{ m.kicker(copy.SECTIONS.capabilities.kicker, "ember") }}
  {{ m.heading(copy.SECTIONS.capabilities.title) }}
  {{ m.lede("Perceiving the page as structure rather than pixels, acting with a human hand, and remembering enough to run the whole thing again unprompted.") }}

  <div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-3" data-reveal data-stagger>
    {%- for group in copy.TOOL_GROUPS %}
    {%- set a = m.ACCENT[group.accent] %}
    <article class="card spotlight px-5 py-6">
      <div class="flex items-center gap-2.5">
        <span class="size-2 rounded-full {{ a.dot }}"></span>
        <h3 class="font-display text-[1.05rem] font-semibold text-ink">{{ group.label }}</h3>
        <span class="ml-auto font-mono text-[0.72rem] text-ink-faint">{{ group.tools.length }}</span>
      </div>
      <p class="mt-3 line-clamp-4 text-[0.86rem] leading-relaxed text-ink-faint">{{ group.blurb }}</p>
      <div class="mt-4 flex flex-wrap gap-1.5">
        {%- for tool in group.tools | take(4) %}{{ m.toolChip(tool) }}{% endfor %}
        {%- if group.tools.length > 4 %}<span class="self-center font-mono text-[0.72rem] text-ink-faint">+{{ group.tools.length - 4 }}</span>{% endif %}
      </div>
    </article>
    {%- endfor %}
  </div>

  <div class="mt-8 flex flex-wrap gap-3">
    {{ m.button("/capabilities/", "All 41 tools, grouped") }}
    {{ m.button("/docs/reference/tools/", "Full tool reference", "ghost") }}
  </div>
{% endcall %}

<!-- Tool marquee -->
<section class="marquee overflow-hidden border-b border-line bg-ground-2/30 py-6">
  <div class="mask-x">
    <div class="marquee-track flex w-max gap-2.5">
      {%- for pass in [1, 2] %}{% for tool in copy.ALL_TOOLS %}
      <code class="whitespace-nowrap rounded-md border border-line bg-surface/30 px-2.5 py-1.5 font-mono text-[0.74rem] text-ink-faint">{{ tool }}</code>
      {%- endfor %}{% endfor %}
    </div>
  </div>
</section>

<!-- Orchestration -->
{% call m.section("orchestrate") %}
  {{ m.kicker(copy.SECTIONS.orchestrate.kicker, "magenta") }}
  {{ m.heading(copy.SECTIONS.orchestrate.title) }}
  {{ m.lede(copy.SECTIONS.orchestrate.lede) }}

  <div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-4" data-reveal data-stagger>
    {%- for s in copy.ORCHESTRATION_SESSIONS %}
    <article class="card spotlight px-5 py-5">
      <div class="flex items-center justify-between gap-2">
        <span class="truncate font-mono text-[0.72rem] text-ink-faint">{{ s.host }}</span>
        <span class="shrink-0 rounded-full px-2 py-0.5 font-mono text-[0.65rem] {% if s.status == 'working' %}bg-lime/10 text-lime{% elif s.status == 'approval' %}bg-amber/10 text-amber{% else %}bg-surface text-ink-faint{% endif %}">
          {%- if s.status == 'working' %}<span class="pulse relative mr-1 inline-block size-1.5 rounded-full bg-lime align-middle text-lime"></span>{% endif -%}
          {{ s.status }}</span>
      </div>
      <h3 class="mt-3 font-display text-[0.98rem] font-medium leading-snug text-ink">{{ s.title }}</h3>
      <ul class="mt-3 space-y-1.5">
        {%- for line in s.timeline %}
        <li class="flex gap-2 text-[0.8rem] leading-relaxed text-ink-faint"><span class="mt-1.5 size-1 shrink-0 rounded-full bg-ink-faint/60"></span>{{ line }}</li>
        {%- endfor %}
      </ul>
      <p class="mt-4 border-t border-line pt-3 font-mono text-[0.7rem] text-ink-faint">{{ s.agent }}</p>
    </article>
    {%- endfor %}
  </div>

  <div class="mt-8">{{ m.button("/orchestration/", "How several agents share one browser", "ghost") }}</div>
{% endcall %}

<!-- Automations -->
{% call m.section("automations") %}
  {{ m.kicker(copy.SECTIONS.automations.kicker, "amber") }}
  {{ m.heading(copy.SECTIONS.automations.title) }}
  {{ m.lede(copy.SECTIONS.automations.lede) }}

  <div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-3" data-reveal data-stagger>
    {%- for a in copy.AUTOMATIONS %}
    {%- set ac = m.ACCENT[a.accent] %}
    <article class="card spotlight px-5 py-6">
      <span class="size-2 rounded-full {{ ac.dot }} block"></span>
      <h3 class="mt-3.5 font-display text-[1.02rem] font-semibold leading-snug text-ink">{{ a.title }}</h3>
      <p class="mt-2.5 text-[0.86rem] leading-relaxed text-ink-faint">{{ a.body }}</p>
      <p class="mt-4 border-t border-line pt-3 text-[0.78rem] {{ ac.text }}">{{ a.gate }}</p>
    </article>
    {%- endfor %}
  </div>

  <div class="mt-8">{{ m.button("/automations/", "See what people hand over", "ghost") }}</div>
{% endcall %}

<!-- Skills -->
{% call m.section("teach") %}
  {{ m.kicker(copy.SECTIONS.teach.kicker, "lime") }}
  {{ m.heading(copy.SECTIONS.teach.title) }}
  {{ m.lede(copy.SECTIONS.teach.lede) }}

  {%- set TAB_ACCENT = { "site-maps": "lime", recordings: "amber", instant: "brand" } %}

  <div class="mt-12" data-tabs data-reveal>
    <div class="relative border-b border-line">
      <div class="flex gap-6 overflow-x-auto" role="tablist" aria-label="How you teach it">
        {%- for mode in copy.MODES %}
        <button type="button" role="tab" id="tab-{{ mode.id }}" aria-controls="panel-{{ mode.id }}"
                aria-selected="{{ 'true' if loop.first else 'false' }}" tabindex="{{ '0' if loop.first else '-1' }}"
                class="tab-label shrink-0 whitespace-nowrap pb-3 font-display text-[0.95rem] transition-colors {% if loop.first %}text-ink{% else %}text-ink-faint{% endif %}">{{ mode.tab }}</button>
        {%- endfor %}
      </div>
      <span class="tab-underline" aria-hidden="true"></span>
    </div>

    {%- for mode in copy.MODES %}
    {%- set acc = m.ACCENT[TAB_ACCENT[mode.id]] %}
    <div role="tabpanel" id="panel-{{ mode.id }}" aria-labelledby="tab-{{ mode.id }}" class="pt-9" {% if not loop.first %}hidden{% endif %}>
      <div class="grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-start">
        <div>
          <p class="font-display text-[0.7rem] uppercase tracking-[0.1em] text-ink-faint">{{ mode.kicker }}</p>
          <h3 class="mt-2.5 max-w-xl font-display text-[1.5rem] font-semibold leading-snug text-ink">{{ mode.title }}</h3>
          <p class="mt-4 max-w-xl text-[0.95rem] leading-relaxed text-ink-dim">{{ mode.body }}</p>
          <code class="mt-5 inline-block rounded-lg border border-line bg-surface/40 px-3 py-2 font-mono text-[0.8rem] {{ acc.text }}">{{ mode.invocation }}</code>

          <ul class="mt-7 space-y-4">
            {%- for point in mode.points %}
            <li>
              <h4 class="font-display text-[0.94rem] font-medium text-ink">{{ point[0] }}</h4>
              <p class="mt-1 text-[0.86rem] leading-relaxed text-ink-faint">{{ point[1] }}</p>
            </li>
            {%- endfor %}
          </ul>
        </div>

        <div class="card overflow-hidden">
          <div class="border-b border-line px-4 py-2.5">
            <span class="font-mono text-[0.7rem] uppercase tracking-wider text-ink-faint">{{ mode.tab }}</span>
          </div>
          <ul class="divide-y divide-line font-mono text-[0.78rem]">
            {%- for row in mode.tree %}
            <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1 px-4 py-2.5">
              <span class="{{ acc.text }}">{{ row[0] }}</span>
              {%- if row[1] %}<span class="text-ink-faint">{{ row[1] }}</span>{% endif %}
            </li>
            {%- endfor %}
          </ul>
        </div>
      </div>
    </div>
    {%- endfor %}
  </div>

  <div class="mt-10">{{ m.button("/skills/", "Site maps, recordings and instant commands", "ghost") }}</div>
{% endcall %}

<!-- The extension itself: what the side panel does -->
{% call m.section("panel", "bg-ground-2/30") %}
  <div class="grid gap-12 lg:grid-cols-[1fr_1fr] lg:items-center">
    <div>
      {{ m.kicker(copy.SECTIONS.panel.kicker) }}
      {{ m.heading(copy.SECTIONS.panel.title) }}
      {{ m.lede(copy.SECTIONS.panel.lede) }}
      <div class="mt-8 flex flex-wrap gap-3">
        {{ m.button("/install/", "Install the extension") }}
        {{ m.button("/skills/", "Teach it your own jobs", "ghost") }}
      </div>
    </div>
    <div class="space-y-4" data-reveal data-stagger>
      {%- for point in copy.PANEL_POINTS %}
      <div class="card px-5 py-5">
        <h3 class="font-display text-[1rem] font-semibold text-ink">{{ point.title }}</h3>
        <p class="mt-2 text-[0.86rem] leading-relaxed text-ink-faint">{{ point.body }}</p>
      </div>
      {%- endfor %}
    </div>
  </div>
{% endcall %}

<!-- One integration path gets a band, not a section -->
{%- set bandAccent = m.ACCENT["brand-deep"] %}
<section id="mcp" class="border-b border-line">
  <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-6 gap-y-3 px-5 py-8 sm:px-8" data-reveal>
    <span class="rounded-full border {{ bandAccent.border }} {{ bandAccent.soft }} px-3 py-1 font-display text-[0.7rem] font-medium uppercase tracking-[0.11em] {{ bandAccent.text }}">{{ copy.MCP_BAND.chip }}</span>
    <p class="min-w-[18rem] flex-1 text-[0.92rem] leading-relaxed text-ink-dim">{{ copy.MCP_BAND.body }}</p>
    <a href="{{ copy.MCP_BAND.cta.href }}" class="text-[0.92rem] font-medium text-ink-dim transition-colors hover:text-ink">{{ copy.MCP_BAND.cta.label }} &rarr;</a>
  </div>
</section>

<!-- Security -->
{% call m.section("security") %}
  {{ m.kicker(copy.SECTIONS.security.kicker, "ember") }}
  {{ m.heading(copy.SECTIONS.security.title) }}
  {{ m.lede(copy.SECTIONS.security.lede) }}

  <div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-3" data-reveal data-stagger>
    {%- for s in copy.SECURITY %}
    <article class="card spotlight px-5 py-6">
      <h3 class="font-display text-[1rem] font-semibold leading-snug text-ink">{{ s.title }}</h3>
      <p class="mt-2.5 text-[0.86rem] leading-relaxed text-ink-faint">{{ s.body }}</p>
    </article>
    {%- endfor %}
  </div>

  <div class="card mt-4 border-amber/25 bg-amber/5 px-6 py-6" data-reveal>
    <h3 class="font-display text-[1rem] font-semibold text-amber">Two limits worth stating</h3>
    <div class="mt-4 grid gap-5 sm:grid-cols-2">
      {%- for l in copy.LIMITS %}
      <div>
        <p class="font-display text-[0.92rem] font-medium text-ink">{{ l.title }}</p>
        <p class="mt-1.5 text-[0.85rem] leading-relaxed text-ink-faint">{{ l.body }}</p>
      </div>
      {%- endfor %}
    </div>
  </div>

  <div class="mt-8">{{ m.button("/security/", "Read the security model", "ghost") }}</div>
{% endcall %}

<!-- Quickstart -->
{% call m.section("start", "bg-ground-2/30") %}
  {{ m.kicker(copy.SECTIONS.start.kicker) }}
  {{ m.heading(copy.SECTIONS.start.title) }}
  {{ m.lede(copy.SECTIONS.start.lede) }}

  <ol class="mt-12 grid gap-4 lg:grid-cols-2" data-reveal data-stagger>
    {%- for step in copy.QUICKSTART %}
    <li id="step-{{ loop.index }}" class="card px-5 py-6">
      <div class="flex items-baseline gap-3">
        <span class="font-mono text-[0.8rem] text-brand">{{ step.n }}</span>
        <h3 class="font-display text-[1.05rem] font-semibold text-ink">{{ step.title }}</h3>
      </div>
      <p class="mt-2.5 text-[0.87rem] leading-relaxed text-ink-faint">{{ step.body }}</p>
      <div class="mt-4">{{ m.codeblock(step.code, step.lang) }}</div>
    </li>
    {%- endfor %}
  </ol>

  <div class="mt-8">{{ m.button("/install/", "Full install guide", "ghost") }}</div>
{% endcall %}

<!-- FAQ -->
{% call m.section("faq") %}
  {{ m.kicker(copy.SECTIONS.faq.kicker) }}
  {{ m.heading(copy.SECTIONS.faq.title) }}

  <div class="mt-10 max-w-3xl divide-y divide-line border-y border-line" data-reveal>
    {%- for item in copy.FAQ | take(5) %}
    <details class="faq group py-5"{% if loop.first %} open{% endif %}>
      <summary class="flex items-start gap-4">
        <h3 class="flex-1 font-display text-[1.02rem] font-medium text-ink">{{ item.q }}</h3>
        <span class="chev mt-1 shrink-0 text-ink-faint" aria-hidden="true">
          <svg viewBox="0 0 16 16" class="size-4" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M8 3.5v9M3.5 8h9" stroke-linecap="round"/></svg>
        </span>
      </summary>
      <p class="mt-3 max-w-2xl pr-8 text-[0.92rem] leading-relaxed text-ink-dim">{{ item.a }}</p>
    </details>
    {%- endfor %}
  </div>

  <div class="mt-8">{{ m.button("/faq/", "All questions", "ghost") }}</div>
{% endcall %}

{{ m.cta(copy) }}
