<header id="sitenav" class="fixed inset-x-0 top-0 z-50 transition-all duration-300">
  <div class="mx-auto flex h-16 max-w-7xl items-center gap-6 px-5 sm:px-8">

    <a href="/" class="flex shrink-0 items-center gap-2.5" {% if page.url == '/' %}aria-current="page"{% endif %}>
      {% include "partials/logo.njk" %}
      <span class="font-display text-[1.0625rem] font-semibold tracking-tight text-ink">Browsentic</span>
    </a>

    <nav class="ml-2 hidden items-center gap-1 lg:flex" aria-label="Primary">
      {%- for item in site.nav %}
      <a href="{{ item.href }}"
         class="rounded-lg px-3 py-2 text-[0.9rem] transition-colors {% if pageKey == item.key %}text-ink{% else %}text-ink-dim hover:text-ink{% endif %}"
         {% if pageKey == item.key %}aria-current="page"{% endif %}>{{ item.label }}</a>
      {%- endfor %}
    </nav>

    <div class="ml-auto flex items-center gap-2.5">
      <a href="{{ site.repo }}/releases" class="hidden rounded-full border border-line px-2.5 py-1 font-mono text-[0.7rem] text-ink-faint transition-colors hover:border-line-strong hover:text-ink-dim sm:block">{{ site.version }}</a>

      <a href="{{ site.repo }}" class="hidden items-center gap-1.5 rounded-lg px-3 py-2 text-[0.9rem] text-ink-dim transition-colors hover:text-ink sm:flex">
        <svg viewBox="0 0 16 16" class="size-4" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
        GitHub
      </a>

      <a href="/install/" class="rounded-lg bg-brand px-3.5 py-2 text-[0.9rem] font-medium text-ground transition-opacity hover:opacity-90">Install</a>

      <details id="mobilenav" class="lg:hidden">
        <summary class="flex size-9 cursor-pointer list-none items-center justify-center rounded-lg border border-line text-ink-dim" aria-label="Open menu">
          <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"/></svg>
        </summary>
        <div class="fixed inset-x-0 top-16 bottom-0 z-40 overflow-y-auto border-t border-line bg-ground/98 px-5 py-6 backdrop-blur-xl">
          <nav class="flex flex-col gap-1" aria-label="Mobile">
            {%- for item in site.nav %}
            <a href="{{ item.href }}" class="rounded-lg px-3 py-3 text-lg {% if pageKey == item.key %}text-ink{% else %}text-ink-dim{% endif %}">{{ item.label }}</a>
            {%- endfor %}
            <a href="/faq/" class="rounded-lg px-3 py-3 text-lg text-ink-dim">FAQ</a>
            <a href="{{ site.repo }}" class="rounded-lg px-3 py-3 text-lg text-ink-dim">GitHub</a>
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>
