<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">

{%- set pageTitle = seoTitle or title -%}
{%- set canonical = (canonicalOverride or page.url) | absolute -%}
{%- set image = (ogImage or "/og.png") | absolute -%}
{%- set desc = description | trim -%}

<title>{{ pageTitle }}</title>
<meta name="description" content="{{ desc }}">
<link rel="canonical" href="{{ canonical }}">
{%- if noindex %}
<meta name="robots" content="noindex, follow">
{%- else %}
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
{%- endif %}
{%- if keywords %}
<meta name="keywords" content="{{ keywords | join(', ') }}">
{%- endif %}
<meta name="author" content="{{ site.author }}">
<meta name="generator" content="Eleventy">
<meta name="google-site-verification" content="Gmr19xvpOAMf0o5vcWy5pw_E0jikNDjuRXHCPm1K4Bw">

<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:site_name" content="Browsentic">
<meta property="og:locale" content="en_US">
<meta property="og:title" content="{{ socialTitle or pageTitle }}">
<meta property="og:description" content="{{ socialDescription or desc }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:image" content="{{ image }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ imageAlt or copy.SEO.imageAlt }}">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ socialTitle or pageTitle }}">
<meta name="twitter:description" content="{{ socialDescription or desc }}">
<meta name="twitter:image" content="{{ image }}">
<meta name="twitter:image:alt" content="{{ imageAlt or copy.SEO.imageAlt }}">

<meta name="theme-color" content="{{ site.themeColor }}">
<meta name="color-scheme" content="dark">
<link rel="icon" type="image/png" sizes="32x32" href="/icon/32.png">
<link rel="icon" type="image/png" sizes="128x128" href="/icon/128.png">
<link rel="apple-touch-icon" href="/icon/128.png">
<link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt">
<link rel="sitemap" type="application/xml" href="/sitemap.xml">

<link rel="preload" href="/fonts/inter-tight-600-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/inter-400-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/main.css">

<script type="application/ld+json">{{ structuredData | jsonld | safe }}</script>
</head>

<body class="min-h-screen antialiased">
<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[200] focus:rounded-lg focus:bg-surface focus:px-4 focus:py-2 focus:text-sm focus:text-ink">Skip to content</a>

{% include "partials/nav.njk" %}

<main id="main">
{{ content | safe }}
</main>

{% include "partials/footer.njk" %}

<script src="/assets/js/site.js" defer></script>
</body>
</html>
