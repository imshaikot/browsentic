{% import "partials/macros.njk" as m with context %}

<section class="relative overflow-hidden">
  <div class="dot-grid mask-radial pointer-events-none absolute inset-0"></div>
  <div class="relative mx-auto max-w-3xl px-5 py-32 text-center sm:px-8">
    <p class="font-mono text-[0.8rem] text-ink-faint">404</p>
    <h1 class="mt-4 font-display text-[2.4rem] font-semibold leading-tight text-ink sm:text-[3rem]">This page does not exist</h1>
    <p class="mx-auto mt-5 max-w-lg text-[1.02rem] leading-relaxed text-ink-dim">The link may be stale, or the page may have moved when the site was restructured. These are the useful places to land instead.</p>
    <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
      {{ m.button("/", "Home") }}
      {{ m.button("/docs/", "Documentation", "ghost") }}
      {{ m.button("/install/", "Install guide", "ghost") }}
    </div>
  </div>
</section>
