{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // DOM is here to type-check `lib/actions/**`, which this package bundles for its schemas.
    // Those DOM references live inside `execute()` bodies and never run in Node.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@/*": ["../*"],
      // lib/actions/** lives at the repository root and would otherwise resolve the root's
      // own zod, putting two copies of the same 4.4.3 release (~450 KB) into the bundle.
      // Pin both halves at the copy that actually runs. Verify with `esbuild --analyze`:
      // only `node_modules/zod/...` should appear, never `../node_modules/zod/...`.
      "zod": ["./node_modules/zod"],
      "zod/*": ["./node_modules/zod/*"]
    }
  },
  "include": ["**/*.ts", "../lib/actions/**/*", "../lib/skills/**/*"],
  "exclude": ["node_modules", "dist"]
}
